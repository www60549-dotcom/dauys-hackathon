# Docker Compose reads .env automatically. Replace empty passwords locally.
# Never commit the resulting .env or reuse the public demo/test passwords.
# Use a URL-safe random database password, e.g. 32 hexadecimal characters.
POSTGRES_PASSWORD=
# Demo-only fresh database; false for an existing company database.
# Set a unique DEMO_PASSWORD before the first seed. Existing users are not reset.
DEMO_MODE=true
DEMO_PASSWORD=
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
WEB_BIND=127.0.0.1
WEB_PORT=8088

# Direct Go API configuration. Go does NOT read this file automatically:
# export these variables in your shell or set them in the hosting environment.
# DATABASE_URL format: postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
# Compose builds its own DATABASE_URL from POSTGRES_PASSWORD; this line is unused there.
DATABASE_URL=
HOST=127.0.0.1
PORT=8080
UPLOAD_DIR=data/uploads
DIST_DIR=dist
# Reachable site origin used by QR links. Set a real HTTPS origin for a public demo.
APP_PUBLIC_URL=http://127.0.0.1:8080

# Optional local overrides: Vite API proxy target and prepared Go/PostgreSQL tools.
# DAUYS_API_TARGET is read from the process environment, not automatically from .env.
DAUYS_API_TARGET=http://127.0.0.1:8080
DAUYS_RUNTIME_DIR=

# Public HTTPS backend origin for Vercel, without /api or a trailing path.
PUBLIC_API_ORIGIN=
