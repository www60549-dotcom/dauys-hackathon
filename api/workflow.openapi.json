    "/appeals/similar": {
      "get": {
        "operationId": "findSimilarAppeals",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 12000
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Heuristic thematic matches from stored appeals; score is not a measured probability",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SimilarAppeal"
                      }
                    },
                    "method": {
                      "const": "local_concepts"
                    }
                  },
                  "required": [
                    "items",
                    "method"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Request error",
            "content": {
