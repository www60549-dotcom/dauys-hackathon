  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dauys_session"
      }
    },
    "schemas": {
      "Appeal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "problem",
              "idea",
              "praise"
            ]
          },
          "category": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "review",
              "progress",
              "waiting",
              "resolved",
              "closed",
              "rejected"
            ]
          },
          "author_id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "assignee_id": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "affected": {
            "type": "integer",
            "minimum": 1
          },
          "expected_effect": {
            "type": "integer"
          },
          "actual_effect": {
            "type": "integer"
          },
          "result": {
            "type": "string"
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "confirmed": {
            "type": "boolean"
          },
          "votes": {
            "type": "integer"
          },
          "voted": {
            "type": "boolean"
          },
          "score": {
            "type": "integer"
          },
          "recurrence_count": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "description",
          "solution",
          "kind",
          "category",
          "department",
          "priority",
          "status",
          "author_id",
          "author",
          "assignee_id",
          "assignee",
          "parent_id",
          "affected",
          "expected_effect",
          "actual_effect",
          "result",
          "due_at",
          "created_at",
          "updated_at",
          "confirmed",
          "votes",
          "voted",
          "score",
          "recurrence_count"
        ]
      },
      "HistoryEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "from_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "new",
              "review",
              "progress",
              "waiting",
              "resolved",
              "closed",
              "rejected",
              null
            ]
          },
          "to_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "new",
              "review",
              "progress",
              "waiting",
              "resolved",
              "closed",
              "rejected",
              null
            ]
          },
          "appeal_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "action",
          "created_at",
          "name",
          "actor_id",
          "event_type",
          "from_status",
          "to_status",
          "appeal_version",
          "details"
        ]
      },
      "Permissions": {
        "type": "object",
        "properties": {
          "can_edit": {
            "type": "boolean"
          },
          "can_manage": {
            "type": "boolean"
          },
          "can_comment": {
            "type": "boolean"
          }
        },
        "required": [
          "can_edit",
          "can_manage",
          "can_comment"
        ]
      },
      "Detail": {
        "type": "object",
        "properties": {
          "appeal": {
            "$ref": "#/components/schemas/Appeal"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEvent"
            }
          },
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "author_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "employee",
                    "executor",
                    "admin"
                  ]
                },
                "body": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "author_id",
                "name",
                "role",
                "body",
                "created_at"
              ]
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "size"
              ]
            }
          },
          "linked": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
