    "/appeals/{id}/impact": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "saveImpact",
        "description": "Full monthly estimate; expected_appeal_version is mandatory. Increments the appeal revision. Zero hourly_rate means unknown financial value; estimates never add confirmed savings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImpactCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estimate saved; refresh the feature snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "400": {
